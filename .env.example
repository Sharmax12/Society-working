# Transactional email
RESEND_API_KEY=
EMAIL_FROM=HallWayLoop <onboarding@resend.dev>

# Database and authentication
DATABASE_URL=
# Generate with: openssl rand -base64 48 (at least 32 characters).
AUTH_SECRET=
# Optional separate HMAC key for privacy-preserving rate-limit buckets.
# If empty, AUTH_SECRET is used. When set, use a random value of 32+ characters.
RATE_LIMIT_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required before enabling sign-in: comma-separated exact college domains.
# Example only — replace with approved pilot college domains.
COLLEGE_EMAIL_DOMAINS=university.edu,example.ac.in
